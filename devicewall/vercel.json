{
  "headers": [
    {
      "source": "/devicewall/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Expose-Headers", "value": "Content-Length" },
        { "key": "Cache-Control", "value": "public, max-age=300" }
      ]
    }
  ]
}
